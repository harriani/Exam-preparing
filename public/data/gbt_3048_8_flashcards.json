    {
      "id": "gbt_3048_8_012",
      "kind": "判断",
      "family": "GB/T 3048.8-2025",
      "std": "GB/T 3048.8-2025",
      "method": "definition",
      "priority": "P1",
      "front": "试验过程中因故停止施加电压，恢复试验时可以接着原来的时间继续计时。",
      "back": "✗ 错误\n解析: 除非产品标准另有规定，恢复时应重新计时。中断会使绝缘内部电荷状态改变，累计计时不等效。",
