  "generated_from": "kb/judged.json（13 条考点 KU）",
  "src_rule": "每张卡溯源标准号+条款，杜绝凭记忆编造；priority/method 取自 KU 的 priority 与 type",
  "cards": [
    {"id":"F01","kind":"fact","family":"2951.13","std":"GB/T 2951.13-2008","method":"sample_prep","priority":"P1","front":"试样挤出或硫化（交联）后，试验前应存放至少多久？","back":"至少 16h，使材料状态稳定后再试验。","src":"GB/T 2951.13-2008 条款5 预处理"},
    {"id":"F02","kind":"fact","family":"2951.13","std":"GB/T 2951.13-2008","method":"sample_prep","priority":"P1","front":"试验在(23±5)℃环境下进行时，试样须在该环境存放至少多久？","back":"至少 3h。注意与比重瓶法的(23±2)℃保存、(23±0.5)℃液浴区分。","src":"GB/T 2951.13-2008 条款5 预处理"},
    {"id":"F03","kind":"definition","family":"2951.13","std":"GB/T 2951.13-2008","method":"test_method","priority":"P0","front":"悬浮法测密度：试样怎么切、读数精度、试液怎么选？","back":"沿垂直导体轴线切 (1~2)mm 小块；比重计读数到小数点后三位即为密度；密度<1g/mL 用乙醇/水混合物，≥1g/mL 用氯化锌/水混合物。","src":"GB/T 2951.13-2008 条款8.1 悬浮法"},
    {"id":"F04","kind":"definition","family":"2951.13","std":"GB/T 2951.13-2008","method":"test_method","priority":"P0","front":"比重瓶法（基准法）关键参数？","back":"试样质量 1~5g；试样保存(23±2)℃；比重瓶在液浴达(23±0.5)℃；96% 酒精试液密度 0.7988 g/mL。","src":"GB/T 2951.13-2008 条款8.2 比重瓶法"},
    {"id":"F05","kind":"fact","family":"2951.13","std":"GB/T 2951.13-2008","method":"test_method","priority":"P0","front":"吸水试验（电气法）预试验怎么做？","back":"浸水 1h 后，导体与水间施加交流 4kV 保持 5min 不击穿，方可用于主试验。","src":"GB/T 2951.13-2008 条款9.1"},
    {"id":"F06","kind":"cloze","family":"2951.13","std":"GB/T 2951.13-2008","method":"test_method","priority":"P0","front":"吸水电气法：绝缘厚度 1.5mm 时，主试验直流电压为____V。","back":"1400V（表1：1.2<t≤1.6mm 对应 1400V）。","src":"GB/T 2951.13-2008 表1"},
    {"id":"F07","kind":"fact","family":"2951.13","std":"GB/T 2951.13-2008","method":"sample_prep","priority":"P0","front":"吸水试验（重量法）试样制备尺寸？","back":"0.6/1kV 及以下且截面≤25mm² 取约 300mm 一段绝缘线芯；其他电缆磨/削成(0.6~0.9)mm 薄片冲切(80~100)mm×(4~5)mm，每线芯制 2 个试样。","src":"GB/T 2951.13-2008 条款9.2"},
    {"id":"F08","kind":"fact","family":"2951.21","std":"GB/T 2951.21-2008","method":"sample_prep","priority":"P0","front":"耐臭氧试验取样位置与半导电层如何处理？","back":"距端头≥1.5m 取样制 2 个试样；有挤包半导电屏蔽层时：除去 2 个试样的屏蔽层、保留 2 个试样的屏蔽层；哑铃最小厚度 0.6mm。","src":"GB/T 2951.21-2008 条款8.1.2~8.1.3"},
    {"id":"F09","kind":"fact","family":"2951.21","std":"GB/T 2951.21-2008","method":"test_method","priority":"P0","front":"耐臭氧试验暴露条件与合格判据？","back":"(25±2)℃、规定臭氧浓度干燥循环空气，流量 280~560 L/h；伸长 33%±2%；用正常视力检查最远 180° 弯曲部分、哑铃中部窄条应无裂纹（夹具附近裂纹忽略）。","src":"GB/T 2951.21-2008 条款8.1.5"},
    {"id":"F10","kind":"fact","family":"2951.21","std":"GB/T 2951.21-2008","method":"requirement","priority":"P1","front":"耐臭氧试验环境臭氧浓度安全限值？","back":"不应超过 0.1×10⁻⁶（或现行卫生标准较小值）。","src":"GB/T 2951.21-2008 条款8.1 安全警告"},
    {"id":"F11","kind":"definition","family":"2951.31","std":"GB/T 2951.31-2008","method":"test_method","priority":"P0","front":"高温压力试验：k 系数、加热时间、压痕限怎么定？","back":"k：软线/软缆及 D≤15mm 固定敷设=0.6，D>15mm 固定敷设及扇形=0.7；加热：D≤15mm 为 4h，D>15mm 为 6h；压痕中间值≤绝缘厚度平均值的 50%。","src":"GB/T 2951.31-2008 条款8 高温压力试验"},
    {"id":"F12","kind":"cloze","family":"2951.31","std":"GB/T 2951.31-2008","method":"test_method","priority":"P0","front":"D=12mm 的固定敷设电缆做高温压力试验，k=____，加热____h，压痕限为厚度均值的____%。","back":"k=0.6，加热 4h，压痕限 50%。","src":"GB/T 2951.31-2008 条款8"},
    {"id":"F13","kind":"fact","family":"2951.31","std":"GB/T 2951.31-2008","method":"test_method","priority":"P0","front":"抗开裂（热冲击）试验怎么做、判据？","back":"试棒按外径 D（或厚度 δ）选直径与卷绕圈数；预热(150±3)℃ 保持 1h；试样应无裂纹。","src":"GB/T 2951.31-2008 条款9 抗开裂试验"},
    {"id":"F14","kind":"definition","family":"2951.32","std":"GB/T 2951.32-2008","method":"test_method","priority":"P0","front":"失重试验温度、时间、结果单位？","back":"烘箱换气 8~20 次/h（禁旋转风扇），天平感量 0.1mg，(80±2)℃ 保存 7×24h；失重=质量差(mg)/表面积(cm²)，取 3 试件中间值，单位 mg/cm²。","src":"GB/T 2951.32-2008 条款8 失重试验"},
    {"id":"F15","kind":"cloze","family":"2951.32","std":"GB/T 2951.32-2008","method":"test_method","priority":"P0","front":"失重试验结果以____单位表示（质量差除以表面积，取3试件中间值）。","back":"mg/cm²。","src":"GB/T 2951.32-2008 条款8"},
    {"id":"F16","kind":"fact","family":"2951.32","std":"GB/T 2951.32-2008","method":"sample_prep","priority":"P0","front":"热稳定性试验玻璃管尺寸？","back":"长 110mm，外径约 5mm，内径(4.0±0.5)mm，一端密封。","src":"GB/T 2951.32-2008 条款9 热稳定性试验"},
    {"id":"F17","kind":"fact","family":"2951.31","std":"GB/T 2951.31-2008","method":"test_method","priority":"P0","front":"高温压力试验刀片与试样？","back":"刀口厚(0.70±0.01)mm 矩形刀片加压；每线芯从(250~500)mm 样段截 3 个相邻试样，长(50~100)mm。","src":"GB/T 2951.31-2008 条款8"},
    {"id":"F18","kind":"cloze","family":"2951.21","std":"GB/T 2951.21-2008","method":"parameter","priority":"P0","front":"外径 d=18mm 的绝缘线芯做耐臭氧试验，试棒直径选____mm。","back":"5±0.1mm（12.5<d≤20 段）。","src":"GB/T 2951.21-2008 表1"}
  ]
}
